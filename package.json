{
  "name": "pact",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node --import tsx --watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx --env-file-if-exists=.env scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "doctor": "node --import tsx --env-file-if-exists=.env scripts/doctor.ts",
    "release:check": "node --import tsx scripts/release-check.ts",
    "verify:receipt": "node --import tsx --env-file-if-exists=.env scripts/verify-receipt.ts",
    "testnet:readiness": "node --import tsx --env-file-if-exists=.env scripts/testnet-readiness.ts",
    "format": "prettier --write src server tests scripts docs evidence README.md SECURITY.md",
    "dev:preview": "vite --host 0.0.0.0 --mode preview",
    "build:preview": "tsc --noEmit && vite build --mode preview",
    "build:cloudflare": "pnpm build && node scripts/cloudflare-assets.mjs && wrangler deploy --dry-run --minify --outdir .data/cloudflare-build",
    "dev:cloudflare": "wrangler dev --port 8788",
    "smoke:cloudflare": "node scripts/cloudflare-smoke.mjs",
    "types:cloudflare": "wrangler types cloudflare/env.d.ts --strict-vars=false --include-runtime=false",
    "check:cloudflare": "tsc --noEmit -p cloudflare/tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@somnia-chain/markets-sdk": "0.32.1",
    "decimal.js": "^10.6.0",
    "hono": "^4.13.13",
    "https-proxy-agent": "^9.1.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "viem": "^2.57.10",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
