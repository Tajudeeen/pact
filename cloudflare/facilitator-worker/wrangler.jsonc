{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pact-access-facilitator",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pact-access",
      "database_id": "b64ef749-48cd-4638-88d5-add8e8936fe3",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PACT_ACCESS_RESOURCE_URL": "https://pact-access.vercel.app/api/access/resource",
    "PACT_ACCESS_PRICE_ATOMIC": "",
    "PACT_SELLER_PAY_TO": "",
    "CCD_FACILITATOR_ADDRESS": ""
  },
  "limits": {
    "cpu_ms": 10
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
