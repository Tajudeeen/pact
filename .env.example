# Single-server built app. For Vite development, use http://localhost:5173.
PACT_ORIGIN=http://localhost:8787
PORT=8787
PACT_DATABASE=.data/pact.sqlite

# Disabled by default. Never put the owner private key here.
PACT_TESTNET_TRADING=false
PACT_NETWORK=tokyo-testnet
# PACT_OPERATOR_PRIVATE_KEY=0x<dedicated-testnet-operator-key>

# Optional infrastructure overrides. Chain ID 50383 is still enforced.
# PACT_RPC_URL=https://api.hideki2.infra.testnet.somnia.network
# PACT_WS_URL=wss://api.hideki2.infra.testnet.somnia.network/ws
# PACT_INDEXER_URL=https://hideki-dev.smk.somnia.host/v1/graphql
