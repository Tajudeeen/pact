# Single-server built app. For Vite development, use http://localhost:5173.
PACT_ORIGIN=http://localhost:8787
PORT=8787
PACT_DATABASE=.data/pact.sqlite

# Disabled by default. Never put the owner private key here.
PACT_TESTNET_TRADING=false
PACT_NETWORK=tokyo-testnet
# PACT_OPERATOR_PRIVATE_KEY=0x<dedicated-testnet-operator-key>

# Optional infrastructure overrides. Chain ID 50383 is still enforced.
# PACT_RPC_URL=https://api.hideki2.infra.testnet.somnia.network
# PACT_WS_URL=wss://api.hideki2.infra.testnet.somnia.network/ws
# PACT_INDEXER_URL=https://hideki-dev.smk.somnia.host/v1/graphql

# Pact Access / Concordium testnet integration.
# Set true only after the testnet registry, facilitator, seller payout, and file are configured.
PACT_ACCESS_ENABLED=false
PACT_ACCESS_RESOURCE_ROOT=.data/protected
PACT_ACCESS_RESOURCE_FILE=
PACT_ACCESS_SELLER_ID=
PACT_ACCESS_RESOURCE_URL=
PACT_ACCESS_ROUTE=/api/access/resource
PACT_ACCESS_PRICE_ATOMIC=
PACT_ACCESS_ASSET=CCD
PACT_SELLER_PAY_TO=
CONCORDIUM_AGENT_REGISTRY_ID=
CONCORDIUM_AGENT_REGISTRY_MCP_URL=https://agent-registry-mcp.concordium.com/mcp
X402_FACILITATOR_URL=
X402_FACILITATOR_TOKEN=

# Buyer-agent and facilitator secrets live in their separate process environments.
# See docs/buyer-agent.env.example and server/facilitator/.env.example.
