{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pact-access-api",
  "main": "cloudflare/access-api.js",
  "compatibility_date": "2026-11-16",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pact-access",
      "database_id": "b64ef749-48cd-4638-88d5-add8e8936fe3",
      "migrations_dir": "cloudflare/migrations/access"
    }
  ],
  "vars": {
    "PACT_ORIGIN": "https://pact-access.vercel.app",
    "PACT_ACCESS_SELLER_ID": "pact-access-demo",
    "PACT_ACCESS_RESOURCE_URL": "https://pact-access.vercel.app/api/access/resource",
    "CONCORDIUM_AGENT_REGISTRY_INDEX": "12802",
    "CONCORDIUM_AGENT_REGISTRY_SUBINDEX": "0",
    "PACT_PREVIEW_ORIGINS": "https://pact-git-feat-pact-multipage-workspace-deeencodes.vercel.app"
  }
}
